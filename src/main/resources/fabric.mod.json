{
	"schemaVersion": 1,
	"id": "mmetal",
	"version": "${version}",
	"name": "MMetal",
	"description": "MetalFX upscaling, ray traced lighting and motion blur for Minecraft on Apple Silicon.",
	"authors": [
		"MMetal contributors"
	],
	"contact": {
		"homepage": "https://github.com/stoicswe/MMetal",
		"sources": "https://github.com/stoicswe/MMetal"
	},
	"license": "MIT",
	"environment": "client",
	"entrypoints": {
		"client": [
			"dev.mmetal.metal.MetalFxMod"
		]
	},
	"mixins": [
		{
			"config": "mmetal.mixins.json",
			"environment": "client"
		}
	],
	"depends": {
		"fabricloader": ">=0.20.1",
		"minecraft": ">=26.3",
		"java": ">=25",
		"fabric-api": "*"
	}
}
